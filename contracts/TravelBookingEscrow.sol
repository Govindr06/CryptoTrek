pragma solidity ^0.8.20;

/**
 * @title TravelBookingEscrow
 * @dev Secure smart contract for cryptocurrency-based travel itinerary booking.
 * Built for Ethereum Sepolia Testnet deployment within the AWS Cloud Architecture.
 * Handles deposits, merchant settlements, and automatic/manual refunds upon Saga rollbacks.
 */
contract TravelBookingEscrow {
    address public owner;
    address public oracleVerifier; // AWS EC2 / KMS verified oracle account

    enum BookingStatus {
        DoesNotExist,
        Pending,
        Confirmed,
        Refunded,
        Disputed
    }

    struct Booking {
        string bookingId;
        address payable traveler;
        uint256 amountWei;
        uint256 hotelFeeWei;
        uint256 cabFeeWei;
        uint256 platformFeeWei;
        uint256 createdAt;
        BookingStatus status;
        bytes32 verificationHash;
    }

    mapping(string => Booking) public bookings;
    mapping(address => string[]) private userBookings;

    event BookingDeposited(
        string indexed bookingId,
        address indexed traveler,
        uint256 amountWei,
        uint256 timestamp
    );

    event BookingConfirmed(
        string indexed bookingId,
        address indexed traveler,
        uint256 merchantPayoutWei,
        uint256 timestamp
    );

    event BookingRefunded(
        string indexed bookingId,
        address indexed traveler,
        uint256 refundAmountWei,
        string reason,
        uint256 timestamp
    );

    event OracleUpdated(address indexed oldOracle, address indexed newOracle);

    modifier onlyOwner() {
        require(msg.sender == owner, "Only contract owner can execute");
        _;
    }

    modifier onlyOracleOrOwner() {
        require(
            msg.sender == oracleVerifier || msg.sender == owner,
            "Only AWS KMS Oracle or Owner can execute"
        );
        _;
    }

    constructor(address _oracleVerifier) {
        owner = msg.sender;
        oracleVerifier = _oracleVerifier;
    }

    /**
     * @notice Deposit Sepolia ETH for a travel itinerary booking.
     * @param _bookingId Unique booking identifier generated by AWS Lambda/API Gateway.
     * @param _hotelFeeWei Room reservation fee in Wei.
     * @param _cabFeeWei Cab booking fee in Wei.
     * @param _platformFeeWei Platform service fee in Wei.
     */
    function depositBooking(
        string calldata _bookingId,
        uint256 _hotelFeeWei,
        uint256 _cabFeeWei,
        uint256 _platformFeeWei
    ) external payable {
        require(bytes(_bookingId).length > 0, "Invalid booking ID");
        require(bookings[_bookingId].status == BookingStatus.DoesNotExist, "Booking ID already exists");
        
        uint256 expectedTotal = _hotelFeeWei + _cabFeeWei + _platformFeeWei;
        require(msg.value == expectedTotal, "Sent ETH does not match total itinerary fees");
        require(msg.value > 0, "Booking amount must be greater than zero");

        bookings[_bookingId] = Booking({
            bookingId: _bookingId,
            traveler: payable(msg.sender),
            amountWei: msg.value,
            hotelFeeWei: _hotelFeeWei,
            cabFeeWei: _cabFeeWei,
            platformFeeWei: _platformFeeWei,
            createdAt: block.timestamp,
            status: BookingStatus.Pending,
            verificationHash: keccak256(abi.encodePacked(_bookingId, msg.sender, msg.value, block.timestamp))
        });

        userBookings[msg.sender].push(_bookingId);

        emit BookingDeposited(_bookingId, msg.sender, msg.value, block.timestamp);
    }

    /**
     * @notice Confirms booking upon successful completion of AWS Step Functions Saga workflow.
     * Releases funds to the travel service merchants / platform treasury.
     * @param _bookingId The booking identifier.
     * @param _merchantTreasury The merchant or platform payout address.
     */
    function confirmBooking(
        string calldata _bookingId,
        address payable _merchantTreasury
    ) external onlyOracleOrOwner {
        Booking storage b = bookings[_bookingId];
        require(b.status == BookingStatus.Pending, "Booking is not in pending state");
        require(_merchantTreasury != address(0), "Invalid merchant address");

        b.status = BookingStatus.Confirmed;
        uint256 payout = b.amountWei;

        (bool sent, ) = _merchantTreasury.call{value: payout}("");
        require(sent, "Merchant payout transfer failed");

        emit BookingConfirmed(_bookingId, b.traveler, payout, block.timestamp);
    }

    /**
     * @notice Compensating transaction invoked by AWS Step Functions Saga when a step fails.
     * Refunds the Sepolia ETH back to the traveler's MetaMask wallet.
     * @param _bookingId The booking identifier.
     * @param _reason The reason for the rollback (e.g., "Cab booking failed", "Hotel inventory exhausted").
     */
    function refundBooking(
        string calldata _bookingId,
        string calldata _reason
    ) external onlyOracleOrOwner {
        Booking storage b = bookings[_bookingId];
        require(b.status == BookingStatus.Pending, "Booking not eligible for refund");

        b.status = BookingStatus.Refunded;
        uint256 refundAmount = b.amountWei;

        (bool sent, ) = b.traveler.call{value: refundAmount}("");
        require(sent, "Refund transfer to traveler failed");

        emit BookingRefunded(_bookingId, b.traveler, refundAmount, _reason, block.timestamp);
    }

    /**
     * @notice Emergency traveler refund if AWS workflow does not respond within 24 hours.
     */
    function emergencyRefund(string calldata _bookingId) external {
        Booking storage b = bookings[_bookingId];
        require(msg.sender == b.traveler, "Only booking traveler can invoke emergency refund");
        require(b.status == BookingStatus.Pending, "Booking not eligible for emergency refund");
        require(block.timestamp >= b.createdAt + 24 hours, "Emergency refund window not yet reached");

        b.status = BookingStatus.Refunded;
        uint256 refundAmount = b.amountWei;

        (bool sent, ) = b.traveler.call{value: refundAmount}("");
        require(sent, "Emergency refund transfer failed");

        emit BookingRefunded(_bookingId, b.traveler, refundAmount, "Emergency timeout expired", block.timestamp);
    }

    function setOracleVerifier(address _newOracle) external onlyOwner {
        require(_newOracle != address(0), "Invalid oracle address");
        emit OracleUpdated(oracleVerifier, _newOracle);
        oracleVerifier = _newOracle;
    }

    function getBooking(string calldata _bookingId) external view returns (Booking memory) {
        return bookings[_bookingId];
    }

    function getUserBookings(address _user) external view returns (string[] memory) {
        return userBookings[_user];
    }

    receive() external payable {}
}
